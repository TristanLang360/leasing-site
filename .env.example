# Copy to .env (git-ignored) and fill in as needed. All optional —
# with nothing set, the app runs fully locally (disk + SQLite).

# ── Server ─────────────────────────────────────────────
PORT=3030

# ── Master account (seeded on first run) ───────────────
MASTER_EMAIL=you@yourcompany.com
MASTER_PASS=change-me-to-a-strong-password

# ── Email notifications (Resend) ───────────────────────
# Optional. Used to email landlord-intake form submissions.
# With nothing set, submissions still save (admin Landlords tab) and email is skipped.
# 1) Create a free account at resend.com, 2) verify a sender domain/address,
# 3) create an API key.
RESEND_API_KEY=
# Verified sender. Default onboarding@resend.dev works only for testing to your own address.
RESEND_FROM=Rentalium <onboarding@resend.dev>
# Where landlord submissions are emailed. Falls back to MASTER_EMAIL if unset.
LANDLORD_NOTIFY_EMAIL=

# ── Photo storage ──────────────────────────────────────
# local (default) = ./uploads on disk
# supabase        = a Supabase Storage bucket
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=supabase:
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=unit-photos

# ── Database ───────────────────────────────────────────
# sqlite (default) = ./rentalium.db
# postgres         = Supabase/Postgres (driver seam — see lib/repo.postgres.js)
DB_DRIVER=sqlite
DATABASE_URL=
