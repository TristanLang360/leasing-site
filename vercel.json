{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{index.html,units.html,units.js,styles.css,agent-screening.html,landlord-intake.html,favicon.svg,hero-montreal.jpg,*.jpg,*.png,*.svg,*.ico,admin-dist/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
